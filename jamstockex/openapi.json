  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "required": ["api_version", "as_of", "saved_at", "stale", "source", "notice", "license"],
        "properties": {
          "api_version": {"type": "string", "const": "v2"},
          "as_of": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Trading date of the data in this response"
          },
          "saved_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the local data file was last saved (UTC)"
          },
          "stale": {"type": "boolean", "description": "True if the dataset's latest due fetch failed"},
          "source": {"type": "string"},
          "notice": {"type": "string"},
          "license": {"type": "string"}
        }
      },
      "Quote": {
        "type": "object",
        "required": ["date", "close", "change", "change_pct", "volume"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "close": {"type": ["number", "null"]},
          "change": {"type": ["number", "null"]},
          "change_pct": {
            "type": ["number", "null"],
            "description": "From the page, otherwise change / (close - change) x 100"
          },
          "volume": {"type": ["integer", "null"]}
        }
      },
      "Stock": {
        "type": "object",
        "required": [
          "instrument_code",
          "symbol",
          "name",
          "market",
          "currency",
          "sector",
          "type",
          "website",
          "listed",
          "listed_since",
          "delisted_on",
          "quote"
        ],
        "properties": {
          "instrument_code": {"type": "string"},
          "symbol": {"type": "string"},
          "name": {"type": "string"},
          "market": {"type": "string"},
          "currency": {"type": ["string", "null"]},
          "sector": {"type": ["string", "null"]},
          "type": {"type": ["string", "null"]},
          "website": {"type": ["string", "null"], "description": "The company's own website"},
          "listed": {"type": "boolean"},
          "listed_since": {"type": ["string", "null"], "format": "date"},
          "delisted_on": {"type": ["string", "null"], "format": "date"},
          "quote": {"oneOf": [{"$ref": "#/components/schemas/Quote"}, {"type": "null"}]}
        }
      },
      "StockDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/Stock"},
          {
            "type": "object",
            "required": ["corporate_actions", "dividends"],
            "properties": {
              "corporate_actions": {
                "type": "array",
                "items": {"$ref": "#/components/schemas/CorporateAction"}
              },
              "dividends": {"type": "array", "items": {"$ref": "#/components/schemas/CorporateAction"}}
            }
          }
        ]
      },
      "CorporateAction": {
        "type": "object",
        "required": [
          "instrument_code",
          "symbol",
          "type",
          "amount",
          "currency",
          "record_date",
          "ex_date",
          "payment_date"
        ],
        "properties": {
          "instrument_code": {
            "type": ["string", "null"],
            "description": "null when the symbol is unknown or ambiguous"
          },
          "symbol": {"type": "string"},
          "type": {"type": "string", "description": "lowercase snake_case, e.g. dividend"},
          "amount": {"type": ["number", "null"]},
          "currency": {"type": ["string", "null"]},
          "record_date": {"type": ["string", "null"], "format": "date"},
          "ex_date": {"type": ["string", "null"], "format": "date"},
          "payment_date": {"type": ["string", "null"], "format": "date"}
        }
      },
      "MarketIndex": {
        "type": "object",
        "required": ["name", "date", "value", "change", "change_pct", "volume"],
        "properties": {
          "name": {"type": "string"},
          "date": {"type": "string", "format": "date"},
          "value": {"type": ["number", "null"]},
          "change": {"type": ["number", "null"]},
          "change_pct": {"type": ["number", "null"]},
          "volume": {"type": ["integer", "null"]}
        },
        "title": "MarketIndex"
      },
      "DatasetStatus": {
        "type": "object",
        "required": ["as_of", "fetched_at", "stale", "last_error"],
        "properties": {
          "as_of": {"type": ["string", "null"], "format": "date"},
          "fetched_at": {"type": ["string", "null"], "format": "date-time"},
          "stale": {"type": "boolean"},
          "last_error": {"type": ["string", "null"]},
          "no_data_days": {"type": "integer", "minimum": 1, "description": "Quotes only, present when above 0: trading-day refreshes in a row whose page had no trade data. At 3, quotes and indices are marked stale."}
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "listings",
          "quotes",
          "indices",
          "corporate_actions",
          "refreshing",
          "blocked",
          "next_check_at",
          "data_file"
        ],
        "properties": {
          "listings": {
            "allOf": [
              {"$ref": "#/components/schemas/DatasetStatus"},
              {
                "type": "object",
                "required": ["markets", "unmatched_codes"],
                "properties": {
                  "markets": {
                    "type": "object",
                    "additionalProperties": {"$ref": "#/components/schemas/DatasetStatus"}
                  },
                  "unmatched_codes": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Quote codes that no listings page explained"
                  }
                }
              }
            ]
          },
          "quotes": {"$ref": "#/components/schemas/DatasetStatus"},
          "indices": {"$ref": "#/components/schemas/DatasetStatus"},
          "corporate_actions": {"$ref": "#/components/schemas/DatasetStatus"},
          "refreshing": {"type": "boolean"},
          "blocked": {"type": "boolean", "description": "The JSE site blocked the last automated request"},
          "next_check_at": {"type": ["string", "null"], "format": "date-time"},
          "data_file": {"type": "string"}
        }
      },
      "ApiIndex": {
        "type": "object",
        "required": ["name", "api_version", "endpoints", "notice", "source", "license"],
        "properties": {
          "name": {"type": "string"},
          "api_version": {"type": "string"},
          "endpoints": {"type": "object", "additionalProperties": {"type": "string"}},
          "notice": {"type": "string"},
          "source": {"type": "string"},
          "license": {"type": "string"}
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["status", "message"],
            "properties": {"status": {"type": "integer"}, "message": {"type": "string"}}
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Unknown filter, repeated filter or invalid boolean",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"},
            "example": {
              "error": {"status": 400, "message": "Unknown filter(s): sort; allowed: symbol, market, listed"}
            }
          }
        }
      },
      "NotFound": {
        "description": "No such endpoint, instrument or asset",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"},
            "example": {"error": {"status": 404, "message": "Unknown instrument_code: 9099"}}
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Only GET is allowed",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"},
            "example": {"error": {"status": 405, "message": "Method POST not allowed; this API is read-only"}}
          }
        },
        "headers": {"Allow": {"schema": {"type": "string", "example": "GET"}}}
      },
      "ServerError": {
        "description": "Unexpected error; details go to the console only",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Error"},
            "example": {"error": {"status": 500, "message": "Internal server error"}}
          }
        }
      },
      "Forbidden": {
        "description": "The Host header is not 127.0.0.1:<port> or localhost:<port>",
        "content": {
          "text/plain": {
            "schema": {"type": "string"},
            "example": "Forbidden: this API only answers requests addressed to 127.0.0.1:8765 or localhost:8765.\n"
          }
        }
      }
    }
  }
}
